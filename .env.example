NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# New, rotated server-side credential only. Never reuse the retired CAS_PARSER_API_KEY.
FOLIOKEY_CAS_PARSER_API_KEY=
# Optional owner-authorized test window for the existing server-side key.
# ISO UTC deadline (YYYY-MM-DDTHH:mm:ssZ); blank/expired means disabled.
FOLIOKEY_CAS_TEST_EXPIRES_AT=
# Optional future scheduler authorization; scheduled refresh is currently disabled.
CRON_SECRET=
# Optional Jev topic matching only. Disabled by default; never paste real secrets here.
# Requires the reviewed planning/guide migration and privacy review before activation.
FOLIOKEY_ENABLE_JEV_GUIDE=false
FOLIOKEY_JEV_API_KEY=
FOLIOKEY_JEV_MODEL=
